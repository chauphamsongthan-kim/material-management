# Sao chép thành frontend/.env (dùng khi chạy dev) hoặc đặt các biến này
# trên nơi deploy TRƯỚC KHI chạy "npm run build" (Vite nhúng giá trị lúc build).

# Địa chỉ API backend (có /api ở cuối)
VITE_API_URL=http://localhost:5000/api

# Địa chỉ gốc backend (không có /api), dùng để tải ảnh thiết bị
VITE_SERVER_URL=http://localhost:5000

# Khóa PUBLIC của VAPID, trùng với VAPID_PUBLIC_KEY ở backend
VITE_VAPID_PUBLIC_KEY=
