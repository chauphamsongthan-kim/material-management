# =========================================
# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên GitHub.
# =========================================

# Cấu hình Server
PORT=5000

# Cấu hình MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=material_management

# Cấu hình JWT
# BẮT BUỘC: chuỗi ngẫu nhiên dài tối thiểu 32 ký tự, server sẽ không khởi động nếu thiếu/yếu.
# Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Thông báo đẩy (Web Push) - BẮT BUỘC, thiếu thì backend không khởi động.
# Tạo cặp khóa bằng lệnh:  npx web-push generate-vapid-keys
# Khóa PUBLIC cũng phải đặt vào frontend (biến VITE_VAPID_PUBLIC_KEY).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Thư mục lưu ảnh thiết bị. Để trống = backend/uploads.
# Trên Railway: đặt /data/uploads (gắn Volume vào /data).
UPLOAD_DIR=

# (Khuyến nghị) Chỉ cho phép đúng trang web frontend của bạn gọi API.
# Nhiều địa chỉ cách nhau bằng dấu phẩy, không có dấu / ở cuối.
# Ví dụ: CORS_ORIGINS=https://ten-mien-frontend.com
# Để trống = cho mọi trang web (không an toàn bằng).
CORS_ORIGINS=

# (Tùy chọn) Thêm máy chủ push ngoài Google/Mozilla/Apple/Microsoft, cách nhau bằng dấu phẩy.
PUSH_ALLOWED_HOSTS=

# (Tùy chọn) Chỉ dùng khi chạy "npm run seed" / seedHeads.js để tạo tài khoản ban đầu.
# Để trống = script tự sinh mật khẩu ngẫu nhiên và in ra một lần.
SEED_ADMIN_PASSWORD=
SEED_HEAD_PASSWORD=

# (Tùy chọn) Gửi email mã xác minh khi liên kết Gmail / quên mật khẩu.
# Không đặt thì tính năng này tự tắt, phần còn lại của hệ thống vẫn chạy bình thường.
# Với Gmail: bật Xác minh 2 bước, tạo "Mật khẩu ứng dụng" tại
# https://myaccount.google.com/apppasswords rồi dán 16 ký tự vào SMTP_PASS.
# Lưu ý: Railway chặn cổng SMTP ở một số gói; nếu gửi lỗi hãy dùng gói cho phép SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Tên hiển thị người gửi, ví dụ: "Chùa Hội Đức" <ten@gmail.com>
MAIL_FROM=
